PIPELINE_STAGE=DEV

REMOTE_FILESHARE_BACKEND=local
REMOTE_FILESHARE_LOCAL_CACHE_DIR=./.remote-cache
REMOTE_FILESHARE_SYNC_ON_START=false
REMOTE_FILESHARE_ROOT_PREFIX=

# Amazon S3 settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_SESSION_TOKEN=

# Google Drive settings
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_TOKEN_FILE=./.gdrive-token.json
